ENVIRONMENT=production
DB_NAME=aura_assistant
GOOGLE_WEB_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
CORS_ORIGINS=https://replace-with-your-web-origin.example
COOKIE_SECURE=true
AGENT_EMBEDDED_WORKER=true
AGENT_CONTINUOUS_CPU=true
AGENT_WORKER_POLL_SECONDS=0.5
AGENT_LEASE_SECONDS=90
AGENT_RUN_RETENTION_DAYS=30
ACCESS_MIN=15
REFRESH_DAYS=30
JWT_ISSUER=aura-backend
JWT_AUDIENCE=aura-android
